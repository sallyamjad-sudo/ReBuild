  quantity              Decimal           @db.Decimal(18, 3)
  movementType          StockMovementType
  referenceId           String?           @db.Uuid
  performedById         String            @db.Uuid
  createdAt             DateTime          @default(now())

  batch               MaterialBatch      @relation("StockMovement_batchId", fields: [batchId], references: [id], onDelete: Restrict)
  sourceLocation      InventoryLocation? @relation("StockMovement_sourceLocationId", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation InventoryLocation? @relation("StockMovement_destinationLocationId", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  performedBy         User               @relation("StockMovement_performedById", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([performedById])
}

// 14. ProjectAllocation
model ProjectAllocation {
  id               String   @id @default(uuid()) @db.Uuid
