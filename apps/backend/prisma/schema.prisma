enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  DISPOSAL
}

// 13. StockMovement
model StockMovement {
  id                    String            @id @default(uuid()) @db.Uuid
  batchId               String            @db.Uuid
