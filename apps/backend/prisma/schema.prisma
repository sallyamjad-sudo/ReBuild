  damageReports           DamageReport[]           @relation("DamageReport_inventoryStockId")
  materialRecoverys       MaterialRecovery[]       @relation("MaterialRecovery_inventoryStockId")
  wasteRecords            WasteRecord[]            @relation("WasteRecord_inventoryStockId")
  traceabilityCodes       TraceabilityCode[]       @relation("TraceabilityCode_inventoryStockId")
