  project            Project               @relation("PurchaseOrder_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  purchaseOrderItems PurchaseOrderItem[]   @relation("PurchaseOrderItem_purchaseOrderId")
  receiptLines       PurchaseReceiptLine[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([projectId])
}

// 50. PurchaseOrderItem
model PurchaseOrderItem {
  id                    String  @id @default(uuid()) @db.Uuid
  purchaseOrderId       String  @db.Uuid
  purchaseRequestItemId String? @db.Uuid
  materialId            String  @db.Uuid
  orderedQuantity       Decimal @db.Decimal(18, 3)
  receivedQuantity      Decimal @default(0) @db.Decimal(18, 3)
  unitPrice             Decimal @db.Decimal(18, 2)
  unit                  String  @db.VarChar(30)

  purchaseOrder       PurchaseOrder         @relation("PurchaseOrderItem_purchaseOrderId", fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  purchaseRequestItem PurchaseRequestItem?  @relation("PurchaseOrderItem_purchaseRequestItemId", fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)
  material            Material              @relation("PurchaseOrderItem_materialId", fields: [materialId], references: [id], onDelete: Restrict)
  receiptLines        PurchaseReceiptLine[]

  @@index([purchaseOrderId])
  @@index([purchaseRequestItemId])
  @@index([materialId])
}

enum OptimizationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum OptimizationRunObjective {
  MINIMUM_COST
  BALANCED
}

// 51. OptimizationRun
model OptimizationRun {
  id               String                   @id @default(uuid()) @db.Uuid
  companyId        String                   @db.Uuid
  requestItemId    String                   @db.Uuid
  matchResultId    String?                  @db.Uuid
  algorithmVersion String                   @db.VarChar(50)
  status           OptimizationRunStatus
  objective        OptimizationRunObjective
  currencyCode     String                   @db.Char(3)
  startedAt        DateTime
  completedAt      DateTime?
  parameters       Json?                    @db.JsonB

  company             Company              @relation("OptimizationRun_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  requestItem         MaterialRequestItem  @relation("OptimizationRun_requestItemId", fields: [requestItemId], references: [id], onDelete: Restrict)
  matchResult         MatchResult?         @relation("OptimizationRun_matchResultId", fields: [matchResultId], references: [id], onDelete: Restrict)
  optimizationOptions OptimizationOption[] @relation("OptimizationOption_optimizationRunId")

  @@index([companyId])
  @@index([requestItemId])
  @@index([matchResultId])
}

enum OptimizationOptionOptionType {
  TRANSFER
  PURCHASE
  MIXED
}

// 52. OptimizationOption
model OptimizationOption {
  id                    String                       @id @default(uuid()) @db.Uuid
  optimizationRunId     String                       @db.Uuid
  optionType            OptimizationOptionOptionType
  totalCost             Decimal                      @db.Decimal(18, 2)
  transportCost         Decimal                      @default(0) @db.Decimal(18, 2)
  purchaseCost          Decimal                      @default(0) @db.Decimal(18, 2)
  estimatedLeadTimeDays Int?
  coveredQuantity       Decimal                      @db.Decimal(18, 3)
  remainingQuantity     Decimal                      @db.Decimal(18, 3)
  rank                  Int
  isRecommended         Boolean                      @default(false)
  details               Json?                        @db.JsonB

  optimizationRun OptimizationRun          @relation("OptimizationOption_optimizationRunId", fields: [optimizationRunId], references: [id], onDelete: Restrict)
  sourceLines     OptimizationOptionLine[]

  @@unique([optimizationRunId, rank])
  @@index([optimizationRunId])
}

// ==========================================
// PART 8 — SIMULATION / ANALYTICS / PREDICTION
// ==========================================

enum SimulationScenarioStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  FAILED
  ARCHIVED
}

// 53. SimulationScenario
model SimulationScenario {
  id           String                   @id @default(uuid()) @db.Uuid
  companyId    String                   @db.Uuid
  projectId    String?                  @db.Uuid
  createdById  String                   @db.Uuid
  name         String                   @db.VarChar(200)
  description  String?                  @db.Text
  status       SimulationScenarioStatus
  baselineDate DateTime
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  company        Company         @relation("SimulationScenario_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project        Project?        @relation("SimulationScenario_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("SimulationScenario_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  simulationRuns SimulationRun[] @relation("SimulationRun_scenarioId")

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
}

enum SimulationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// 54. SimulationRun
model SimulationRun {
  id               String              @id @default(uuid()) @db.Uuid
  scenarioId       String              @db.Uuid
  algorithmVersion String              @db.VarChar(50)
  status           SimulationRunStatus
  startedAt        DateTime
  completedAt      DateTime?
  inputSnapshot    Json                @db.JsonB
  parameters       Json                @db.JsonB
  resultSummary    Json?               @db.JsonB
  errorMessage     String?             @db.Text

  scenario           SimulationScenario  @relation("SimulationRun_scenarioId", fields: [scenarioId], references: [id], onDelete: Restrict)
  simulationOutcomes SimulationOutcome[] @relation("SimulationOutcome_simulationRunId")

  @@index([scenarioId])
}

enum SimulationOutcomeOutcomeType {
  COST
  TIME
  MATERIAL_USAGE
  WASTE
  RESOURCE_ALLOCATION
}

// 55. SimulationOutcome
model SimulationOutcome {
  id              String                       @id @default(uuid()) @db.Uuid
  simulationRunId String                       @db.Uuid
  outcomeType     SimulationOutcomeOutcomeType
  metricName      String                       @db.VarChar(150)
  metricValue     Decimal                      @db.Decimal(18, 4)
  unit            String?                      @db.VarChar(30)
  details         Json?                        @db.JsonB

  simulationRun SimulationRun @relation("SimulationOutcome_simulationRunId", fields: [simulationRunId], references: [id], onDelete: Restrict)

  @@index([simulationRunId])
}

// 56. AnalyticsSnapshot
model AnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  projectId    String?  @db.Uuid
  metricCode   String   @db.VarChar(150)
  metricValue  Decimal  @db.Decimal(18, 4)
  metricUnit   String?  @db.VarChar(30)
  periodStart  DateTime
  periodEnd    DateTime
  calculatedAt DateTime
  metadata     Json?    @db.JsonB

  company Company  @relation("AnalyticsSnapshot_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation("AnalyticsSnapshot_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
}

enum SustainabilityMetricMetricType {
  WASTE_REDUCTION
  MATERIAL_REUSE
  RECYCLING
  TRANSPORT_EMISSIONS
}

// 57. SustainabilityMetric
model SustainabilityMetric {
  id                String                         @id @default(uuid()) @db.Uuid
  companyId         String                         @db.Uuid
  projectId         String?                        @db.Uuid
  metricType        SustainabilityMetricMetricType
  value             Decimal                        @db.Decimal(18, 4)
  unit              String                         @db.VarChar(30)
  calculationMethod String                         @db.VarChar(200)
  periodStart       DateTime
  periodEnd         DateTime
  calculatedAt      DateTime
  metadata          Json?                          @db.JsonB

  company Company  @relation("SustainabilityMetric_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation("SustainabilityMetric_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([projectId])
}

enum PredictionRunPredictionType {
  DEMAND_FORECAST
  SHORTAGE_RISK
  ANOMALY_DETECTION
}

enum PredictionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// 58. PredictionRun
model PredictionRun {
  id               String                      @id @default(uuid()) @db.Uuid
  companyId        String                      @db.Uuid
  projectId        String?                     @db.Uuid
  modelName        String                      @db.VarChar(150)
  modelVersion     String                      @db.VarChar(50)
  predictionType   PredictionRunPredictionType
  status           PredictionRunStatus
  inputPeriodStart DateTime?
  inputPeriodEnd   DateTime?
  parameters       Json?                       @db.JsonB
  startedAt        DateTime
  completedAt      DateTime?

  company           Company            @relation("PredictionRun_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project           Project?           @relation("PredictionRun_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  predictionResults PredictionResult[] @relation("PredictionResult_predictionRunId")
  anomalyRecords    AnomalyRecord[]    @relation("AnomalyRecord_predictionRunId")

  @@index([companyId])
  @@index([projectId])
}

// 59. PredictionResult
model PredictionResult {
  id              String    @id @default(uuid()) @db.Uuid
  predictionRunId String    @db.Uuid
  materialId      String?   @db.Uuid
  locationId      String?   @db.Uuid
  predictedValue  Decimal   @db.Decimal(18, 4)
  unit            String    @db.VarChar(30)
  forecastDate    DateTime? @db.Date
  confidenceScore Decimal?  @db.Decimal(5, 4)
  details         Json?     @db.JsonB

  predictionRun PredictionRun      @relation("PredictionResult_predictionRunId", fields: [predictionRunId], references: [id], onDelete: Restrict)
  material      Material?          @relation("PredictionResult_materialId", fields: [materialId], references: [id], onDelete: Restrict)
  location      InventoryLocation? @relation("PredictionResult_locationId", fields: [locationId], references: [id], onDelete: Restrict)

  @@index([predictionRunId])
  @@index([materialId])
  @@index([locationId])
}

enum AnomalyRecordSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyRecordStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// 60. AnomalyRecord
model AnomalyRecord {
  id              String                @id @default(uuid()) @db.Uuid
  predictionRunId String                @db.Uuid
  entityType      String                @db.VarChar(100)
  entityId        String                @db.Uuid
  anomalyType     String                @db.VarChar(150)
  severity        AnomalyRecordSeverity
  anomalyScore    Decimal?              @db.Decimal(5, 4)
  explanation     String?               @db.Text
  status          AnomalyRecordStatus
  detectedAt      DateTime
  reviewedById    String?               @db.Uuid
  reviewedAt      DateTime?

  predictionRun PredictionRun @relation("AnomalyRecord_predictionRunId", fields: [predictionRunId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("AnomalyRecord_reviewedById", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([predictionRunId])
  @@index([reviewedById])
}

// 61. SupplierEvaluation
model SupplierEvaluation {
  id                    String    @id @default(uuid()) @db.Uuid
  supplierId            String    @db.Uuid
  evaluatedById         String    @db.Uuid
  qualityScore          Decimal?  @db.Decimal(5, 2)
  deliveryScore         Decimal?  @db.Decimal(5, 2)
  priceScore            Decimal?  @db.Decimal(5, 2)
  overallScore          Decimal?  @db.Decimal(5, 2)
  evaluationPeriodStart DateTime? @db.Date
  evaluationPeriodEnd   DateTime? @db.Date
  notes                 String?   @db.Text
  evaluatedAt           DateTime

  supplier    Supplier @relation("SupplierEvaluation_supplierId", fields: [supplierId], references: [id], onDelete: Restrict)
  evaluatedBy User     @relation("SupplierEvaluation_evaluatedById", fields: [evaluatedById], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([evaluatedById])
}

enum DocumentRecordDocumentType {
  BOQ
  PURCHASE_ORDER
  INVOICE
  DELIVERY_NOTE
  CERTIFICATE
  OTHER
}

// 62. DocumentRecord
model DocumentRecord {
  id               String                     @id @default(uuid()) @db.Uuid
  companyId        String                     @db.Uuid
  uploadedById     String                     @db.Uuid
  projectId        String?                    @db.Uuid
  documentType     DocumentRecordDocumentType
  originalFileName String                     @db.VarChar(255)
  storageKey       String                     @db.VarChar(500)
  mimeType         String                     @db.VarChar(150)
  fileSizeBytes    BigInt
  uploadedAt       DateTime
  metadata         Json?                      @db.JsonB

  company    Company  @relation("DocumentRecord_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("DocumentRecord_uploadedById", fields: [uploadedById], references: [id], onDelete: Restrict)
  project    Project? @relation("DocumentRecord_projectId", fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([uploadedById])
  @@index([projectId])
}

// ==========================================
// DESIGN ADDITIONS (proposed from v0.2 review gates)
// ==========================================

// 63. Normalized sources used by one optimization option.
enum OptimizationOptionSourceType {
  INVENTORY
  SUPPLIER_OFFER
}

model OptimizationOptionLine {
  id                      String                       @id @default(uuid()) @db.Uuid
  optimizationOptionId    String                       @db.Uuid
  sourceType              OptimizationOptionSourceType
  inventoryStockId        String?                      @db.Uuid
  supplierMaterialOfferId String?                      @db.Uuid
  quantity                Decimal                      @db.Decimal(18, 3)
  estimatedUnitCost       Decimal?                     @db.Decimal(18, 2)
  createdAt               DateTime                     @default(now())

  optimizationOption    OptimizationOption     @relation(fields: [optimizationOptionId], references: [id], onDelete: Restrict)
  inventoryStock        InventoryStock?        @relation(fields: [inventoryStockId], references: [id], onDelete: Restrict)
  supplierMaterialOffer SupplierMaterialOffer? @relation(fields: [supplierMaterialOfferId], references: [id], onDelete: Restrict)
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  supplierId            String?                @db.Uuid

  @@index([optimizationOptionId])
  @@index([inventoryStockId])
  @@index([supplierMaterialOfferId])
}

// 64. Traceable procurement receipt lines, linked to material batches.
model PurchaseReceiptLine {
  id                  String   @id @default(uuid()) @db.Uuid
  purchaseOrderItemId String   @db.Uuid
  materialBatchId     String   @db.Uuid
  receivedQuantity    Decimal  @db.Decimal(18, 3)
  receivedAt          DateTime @default(now())
  receivedById        String   @db.Uuid
  notes               String?  @db.Text

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  materialBatch     MaterialBatch     @relation(fields: [materialBatchId], references: [id], onDelete: Restrict)
  receivedBy        User              @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId   String?           @db.Uuid

  @@index([purchaseOrderItemId])
  @@index([materialBatchId])
  @@index([receivedById])
}
