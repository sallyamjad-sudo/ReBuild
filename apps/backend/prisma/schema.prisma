  material  Material            @relation("MaterialAttributeValue_materialId", fields: [materialId], references: [id], onDelete: Restrict)
  attribute AttributeDefinition @relation("MaterialAttributeValue_attributeId", fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([materialId, attributeId])
  @@index([materialId])
  @@index([attributeId])
}

// 11. MaterialBatch
model MaterialBatch {
  id             String    @id @default(uuid()) @db.Uuid
  materialId     String    @db.Uuid
  batchCode      String    @db.VarChar(100)
  supplierId     String?   @db.Uuid
  receivedAt     DateTime?
  manufacturedAt DateTime? @db.Date
