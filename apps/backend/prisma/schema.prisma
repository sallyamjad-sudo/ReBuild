  name      String        @db.VarChar(200)
  status    CompanyStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  projects              Project[]              @relation("Project_companyId")
  warehouses            Warehouse[]            @relation("Warehouse_companyId")
  inventoryLocations    InventoryLocation[]    @relation("InventoryLocation_companyId")
  materialRequests      MaterialRequest[]      @relation("MaterialRequest_companyId")
  transfers             Transfer[]             @relation("Transfer_companyId")
  approvalWorkflows     ApprovalWorkflow[]     @relation("ApprovalWorkflow_companyId")
  damageReports         DamageReport[]         @relation("DamageReport_companyId")
  traceabilityCodes     TraceabilityCode[]     @relation("TraceabilityCode_companyId")
  companyMembers        CompanyMember[]        @relation("CompanyMember_companyId")
  roles                 Role[]                 @relation("Role_companyId")
  auditLogs             AuditLog[]             @relation("AuditLog_companyId")
  materialDemands       MaterialDemand[]       @relation("MaterialDemand_companyId")
  surplusAssessments    SurplusAssessment[]    @relation("SurplusAssessment_companyId")
  suppliers             Supplier[]             @relation("Supplier_companyId")
  purchaseRequests      PurchaseRequest[]      @relation("PurchaseRequest_companyId")
  purchaseOrders        PurchaseOrder[]        @relation("PurchaseOrder_companyId")
  optimizationRuns      OptimizationRun[]      @relation("OptimizationRun_companyId")
  simulationScenarios   SimulationScenario[]   @relation("SimulationScenario_companyId")
  analyticsSnapshots    AnalyticsSnapshot[]    @relation("AnalyticsSnapshot_companyId")
  sustainabilityMetrics SustainabilityMetric[] @relation("SustainabilityMetric_companyId")
  predictionRuns        PredictionRun[]        @relation("PredictionRun_companyId")
  documentRecords       DocumentRecord[]       @relation("DocumentRecord_companyId")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

// 2. Project
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  code        String        @db.VarChar(50)
  name        String        @db.VarChar(200)
  description String?       @db.Text
  status      ProjectStatus
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company               Company                @relation("Project_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  sites                 Site[]                 @relation("Site_projectId")
  warehouses            Warehouse[]            @relation("Warehouse_projectId")
  projectAllocations    ProjectAllocation[]    @relation("ProjectAllocation_projectId")
  materialRequests      MaterialRequest[]      @relation("MaterialRequest_projectId")
  roleAssignments       RoleAssignment[]       @relation("RoleAssignment_projectId")
  materialDemands       MaterialDemand[]       @relation("MaterialDemand_projectId")
  bOQs                  BOQ[]                  @relation("BOQ_projectId")
  purchaseRequests      PurchaseRequest[]      @relation("PurchaseRequest_projectId")
  purchaseOrders        PurchaseOrder[]        @relation("PurchaseOrder_projectId")
  simulationScenarios   SimulationScenario[]   @relation("SimulationScenario_projectId")
  analyticsSnapshots    AnalyticsSnapshot[]    @relation("AnalyticsSnapshot_projectId")
  sustainabilityMetrics SustainabilityMetric[] @relation("SustainabilityMetric_projectId")
  predictionRuns        PredictionRun[]        @relation("PredictionRun_projectId")
  documentRecords       DocumentRecord[]       @relation("DocumentRecord_projectId")

  @@unique([companyId, code])
  @@index([companyId])
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

// 3. Site
model Site {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  name      String     @db.VarChar(200)
  address   String?    @db.Text
  status    SiteStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project            Project            @relation("Site_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  inventoryLocations InventoryLocation? @relation("InventoryLocation_siteId")
  materialRequests   MaterialRequest[]  @relation("MaterialRequest_siteId")
  roleAssignments    RoleAssignment[]   @relation("RoleAssignment_siteId")
  materialDemands    MaterialDemand[]   @relation("MaterialDemand_siteId")

  @@index([projectId])
}

enum WarehouseType {
  CENTRAL
  PROJECT
}

// 4. Warehouse
model Warehouse {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  projectId     String?       @db.Uuid
  name          String        @db.VarChar(200)
  warehouseType WarehouseType
  address       String?       @db.Text
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company            Company            @relation("Warehouse_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project            Project?           @relation("Warehouse_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  inventoryLocations InventoryLocation? @relation("InventoryLocation_warehouseId")

  @@index([companyId])
  @@index([projectId])
}

// 5. InventoryLocation
model InventoryLocation {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  siteId      String?  @unique @db.Uuid
  warehouseId String?  @unique @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company                                Company             @relation("InventoryLocation_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  site                                   Site?               @relation("InventoryLocation_siteId", fields: [siteId], references: [id], onDelete: Restrict)
  warehouse                              Warehouse?          @relation("InventoryLocation_warehouseId", fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryStocks                        InventoryStock[]    @relation("InventoryStock_locationId")
  stockMovementsViaSourceLocationId      StockMovement[]     @relation("StockMovement_sourceLocationId")
  stockMovementsViaDestinationLocationId StockMovement[]     @relation("StockMovement_destinationLocationId")
  transfersViaSourceLocationId           Transfer[]          @relation("Transfer_sourceLocationId")
  transfersViaDestinationLocationId      Transfer[]          @relation("Transfer_destinationLocationId")
  scanEvents                             ScanEvent[]         @relation("ScanEvent_locationId")
  surplusAssessments                     SurplusAssessment[] @relation("SurplusAssessment_locationId")
  predictionResults                      PredictionResult[]  @relation("PredictionResult_locationId")

  @@index([companyId])
}

