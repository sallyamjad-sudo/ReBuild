// 6. MaterialCategory
model MaterialCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  code        String  @unique @db.VarChar(50)
  description String? @db.Text
  isActive    Boolean @default(true)

  categoryAttributes CategoryAttribute[] @relation("CategoryAttribute_categoryId")
  materials          Material[]          @relation("Material_categoryId")
}

enum AttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
}

// 7. AttributeDefinition
model AttributeDefinition {
  id       String            @id @default(uuid()) @db.Uuid
  code     String            @unique @db.VarChar(100)
  name     String            @db.VarChar(150)
  dataType AttributeDataType
  unit     String?           @db.VarChar(30)

  categoryAttributes      CategoryAttribute[]      @relation("CategoryAttribute_attributeId")
  materialAttributeValues MaterialAttributeValue[] @relation("MaterialAttributeValue_attributeId")
}

// 8. CategoryAttribute
model CategoryAttribute {
  categoryId       String  @db.Uuid
  attributeId      String  @db.Uuid
  isRequired       Boolean @default(false)
  isHardConstraint Boolean @default(false)

  category  MaterialCategory    @relation("CategoryAttribute_categoryId", fields: [categoryId], references: [id], onDelete: Restrict)
  attribute AttributeDefinition @relation("CategoryAttribute_attributeId", fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
}

// 9. Material
model Material {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(200)
  baseUnit    String  @db.VarChar(30)
  description String? @db.Text
  isActive    Boolean @default(true)

  category                MaterialCategory         @relation("Material_categoryId", fields: [categoryId], references: [id], onDelete: Restrict)
  materialAttributeValues MaterialAttributeValue[] @relation("MaterialAttributeValue_materialId")
  materialBatchs          MaterialBatch[]          @relation("MaterialBatch_materialId")
  materialRequestItems    MaterialRequestItem[]    @relation("MaterialRequestItem_materialId")
  materialDemands         MaterialDemand[]         @relation("MaterialDemand_materialId")
  surplusAssessments      SurplusAssessment[]      @relation("SurplusAssessment_materialId")
  bOQItems                BOQItem[]                @relation("BOQItem_materialId")
  supplierMaterialOffers  SupplierMaterialOffer[]  @relation("SupplierMaterialOffer_materialId")
  purchaseRequestItems    PurchaseRequestItem[]    @relation("PurchaseRequestItem_materialId")
  purchaseOrderItems      PurchaseOrderItem[]      @relation("PurchaseOrderItem_materialId")
  predictionResults       PredictionResult[]       @relation("PredictionResult_materialId")

  @@index([categoryId])
}

// 10. MaterialAttributeValue
model MaterialAttributeValue {
  materialId  String @db.Uuid
  attributeId String @db.Uuid
