  company              Company               @relation("MaterialRequest_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  project              Project               @relation("MaterialRequest_projectId", fields: [projectId], references: [id], onDelete: Restrict)
  site                 Site                  @relation("MaterialRequest_siteId", fields: [siteId], references: [id], onDelete: Restrict)
  requestedBy          User                  @relation("MaterialRequest_requestedById", fields: [requestedById], references: [id], onDelete: Restrict)
  materialRequestItems MaterialRequestItem[] @relation("MaterialRequestItem_requestId")

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([requestedById])
}

// 16. MaterialRequestItem
model MaterialRequestItem {
  id                    String  @id @default(uuid()) @db.Uuid
  requestId             String  @db.Uuid
  materialId            String  @db.Uuid
  requestedQuantity     Decimal @db.Decimal(18, 3)
  unit                  String  @db.VarChar(30)
  singleBatchOnly       Boolean @default(false)
  technicalRequirements Json?   @db.JsonB
  notes                 String? @db.Text

  request          MaterialRequest   @relation("MaterialRequestItem_requestId", fields: [requestId], references: [id], onDelete: Restrict)
  material         Material          @relation("MaterialRequestItem_materialId", fields: [materialId], references: [id], onDelete: Restrict)
  matchResults     MatchResult[]     @relation("MatchResult_requestItemId")
  reservations     Reservation[]     @relation("Reservation_requestItemId")
  materialDemands  MaterialDemand[]  @relation("MaterialDemand_requestItemId")
  optimizationRuns OptimizationRun[] @relation("OptimizationRun_requestItemId")

  @@index([requestId])
  @@index([materialId])
}

enum MatchStatus {
  FULL_MATCH
  PARTIAL_MATCH
  NO_MATCH
}

// 17. MatchResult
model MatchResult {
  id                      String      @id @default(uuid()) @db.Uuid
  requestItemId           String      @db.Uuid
  algorithmVersion        String      @db.VarChar(50)
  status                  MatchStatus
  requestedQuantity       Decimal     @db.Decimal(18, 3)
  proposedCoveredQuantity Decimal     @db.Decimal(18, 3)
  remainingQuantity       Decimal     @db.Decimal(18, 3)
  executedAt              DateTime
  expiresAt               DateTime?

  requestItem      MaterialRequestItem @relation("MatchResult_requestItemId", fields: [requestItemId], references: [id], onDelete: Restrict)
  matchCandidates  MatchCandidate[]    @relation("MatchCandidate_matchResultId")
  optimizationRuns OptimizationRun[]   @relation("OptimizationRun_matchResultId")

  @@index([requestItemId])
}

// 18. MatchCandidate
model MatchCandidate {
  id               String  @id @default(uuid()) @db.Uuid
  matchResultId    String  @db.Uuid
  inventoryStockId String  @db.Uuid
  eligibleQuantity Decimal @db.Decimal(18, 3)
  proposedQuantity Decimal @db.Decimal(18, 3)
  matchScore       Decimal @db.Decimal(5, 2)
  rank             Int
  explanation      Json?   @db.JsonB

  matchResult    MatchResult    @relation("MatchCandidate_matchResultId", fields: [matchResultId], references: [id], onDelete: Restrict)
  inventoryStock InventoryStock @relation("MatchCandidate_inventoryStockId", fields: [inventoryStockId], references: [id], onDelete: Restrict)

  @@unique([matchResultId, rank])
  @@index([matchResultId])
  @@index([inventoryStockId])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
  CANCELLED
}

// 19. Reservation
model Reservation {
  id                  String            @id @default(uuid()) @db.Uuid
  requestItemId       String            @db.Uuid
  inventoryStockId    String            @db.Uuid
  projectAllocationId String?           @db.Uuid
  quantity            Decimal           @db.Decimal(18, 3)
  status              ReservationStatus
  reservedById        String            @db.Uuid
  reservedAt          DateTime
  expiresAt           DateTime?
  releasedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  requestItem       MaterialRequestItem @relation("Reservation_requestItemId", fields: [requestItemId], references: [id], onDelete: Restrict)
  inventoryStock    InventoryStock      @relation("Reservation_inventoryStockId", fields: [inventoryStockId], references: [id], onDelete: Restrict)
  projectAllocation ProjectAllocation?  @relation("Reservation_projectAllocationId", fields: [projectAllocationId], references: [id], onDelete: Restrict)
  reservedBy        User                @relation("Reservation_reservedById", fields: [reservedById], references: [id], onDelete: Restrict)
  transferItems     TransferItem[]      @relation("TransferItem_reservationId")

  @@index([requestItemId])
  @@index([inventoryStockId])
  @@index([projectAllocationId])
  @@index([reservedById])
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

// 20. Transfer
model Transfer {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  sourceLocationId      String         @db.Uuid
  destinationLocationId String         @db.Uuid
  requestedById         String         @db.Uuid
  status                TransferStatus
  requestedAt           DateTime
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  completedAt           DateTime?
  notes                 String?        @db.Text

  company             Company           @relation("Transfer_companyId", fields: [companyId], references: [id], onDelete: Restrict)
  sourceLocation      InventoryLocation @relation("Transfer_sourceLocationId", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation InventoryLocation @relation("Transfer_destinationLocationId", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  requestedBy         User              @relation("Transfer_requestedById", fields: [requestedById], references: [id], onDelete: Restrict)
  transferItems       TransferItem[]    @relation("TransferItem_transferId")

  @@index([companyId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([requestedById])
}

// 21. TransferItem
model TransferItem {
  id                       String  @id @default(uuid()) @db.Uuid
  transferId               String  @db.Uuid
  reservationId            String  @db.Uuid
  batchId                  String  @db.Uuid
  plannedQuantity          Decimal @db.Decimal(18, 3)
  dispatchedQuantity       Decimal @default(0) @db.Decimal(18, 3)
  receivedQuantity         Decimal @default(0) @db.Decimal(18, 3)
  damagedInTransitQuantity Decimal @default(0) @db.Decimal(18, 3)
  notes                    String? @db.Text

  transfer    Transfer      @relation("TransferItem_transferId", fields: [transferId], references: [id], onDelete: Restrict)
  reservation Reservation   @relation("TransferItem_reservationId", fields: [reservationId], references: [id], onDelete: Restrict)
  batch       MaterialBatch @relation("TransferItem_batchId", fields: [batchId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([reservationId])
  @@index([batchId])
}

